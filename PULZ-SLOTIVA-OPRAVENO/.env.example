# ─────────────────────────────────────────────────────────────
#  Slotiva – konfigurace serveru
#  Zkopíruj tento soubor jako ".env" a vyplň hodnoty.
# ─────────────────────────────────────────────────────────────

# Port serveru a veřejná adresa (bez lomítka na konci).
# Na produkci např. https://slotiva.cz – musí přesně sedět s tím,
# co je v Google Cloud Console v "Authorized redirect URIs".
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# production = zapne bezpečné cookies (vyžaduje HTTPS) a důvěru v proxy hostingu
NODE_ENV=development

# Tajný klíč pro podepisování přihlášení a šifrování tokenů Google (min. 32 znaků).
# Když ho nevyplníš, vygeneruje se do DATA_DIR/.secret – pak ho zálohuj s databází.
# Vygeneruješ příkazem: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Kam se ukládá databáze (SQLite). Na hostingu nastav na trvalý disk/volume, např. /data
DATA_DIR=./data

# ── Správce ──────────────────────────────────────────────────
# E-maily, které mají správcovská práva (seznam všech účtů, blokování, mazání).
# Odděluj čárkou. Práva se přidělí automaticky při registraci i po restartu serveru.
# Tohle je jediné místo, kde se o správcích rozhoduje – kdo tu není, práva nemá.
ADMIN_EMAILS=

# false = nikdo nový se nemůže zaregistrovat (účty zakládáš jen ty)
ALLOW_REGISTRATION=true

# ── Google Kalendář a přihlášení přes Google ─────────────────
# Vytvoř OAuth klienta v Google Cloud Console (typ "Web application").
# Do "Authorized redirect URIs" přidej:  <PUBLIC_BASE_URL>/auth/google/callback
# Bez těchto údajů Slotiva funguje, ale bez napojení na kalendář.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-maily (volitelné) ──────────────────────────────────────
# Bez vyplnění se e-maily neposílají (vše ostatní funguje).
# Seznam: smtp.seznam.cz, port 465, SMTP_SECURE=true
# Gmail:  smtp.gmail.com, port 465, heslo = „heslo aplikace“
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Odesílatel, např. "Slotiva <rezervace@slotiva.cz>"
SMTP_FROM=

# ── Údaje do Podmínek a Ochrany osobních údajů ───────────────
# Doplní se samy do /podminky a /ochrana-osobnich-udaju.
# Bez OPERATOR_NAME zůstanou v textu závorky [DOPLŇTE] a Google
# při ověřování aplikace takovou stránku neuzná.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_ID=
OPERATOR_EMAIL=
# Kde aplikace běží, např. "Railway (servery v EU)"
OPERATOR_HOSTING=
# Věta o ceně v Podmínkách, když je jiná než „služba je zdarma“
OPERATOR_PRICING=
# Datum účinnosti právních dokumentů, např. "1. 3. 2026"
LEGAL_UPDATED=

# ── Ukázka ───────────────────────────────────────────────────
# Rezervační stránka, kterou ukáže /ukazka-webu a odkaz „Jak to vidí klienti“.
# Klidně tvoje vlastní adresa – pak máš co ukázat zákazníkovi.
DEMO_SLUG=

# ── Vkládání na weby ─────────────────────────────────────────
# Weby, které smí vložit rezervační formulář (iframe), oddělené mezerou.
# * = kdokoliv (potřeba, když si uživatelé vkládají rezervace na vlastní weby).
ALLOWED_EMBED_ORIGINS=*
